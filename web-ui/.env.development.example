# Copy to `.env.development` if needed. Vite dev server proxies `/api/*` here.
# Must match the Talky control server port (see root `.env` → `WEB_UI_PORT`, default 4173).

# Full URL (preferred when Talky runs on a non-default host/port):
# VITE_API_PROXY_TARGET=http://127.0.0.1:4173

# Or set only the port (same as Talky's WEB_UI_PORT):
# WEB_UI_PORT=4173
