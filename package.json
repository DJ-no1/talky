{
  "name": "talky",
  "version": "0.1.0",
  "description": "Local-first personal WhatsApp AI agent powered by Gemini — runs on your machine, replies in your style.",
  "license": "MIT",
  "author": "Suman Jana",
  "homepage": "https://github.com/rocker1166/talky",
  "repository": {
    "type": "git",
    "url": "https://github.com/rocker1166/talky.git"
  },
  "bugs": {
    "url": "https://github.com/rocker1166/talky/issues"
  },
  "keywords": [
    "whatsapp",
    "ai-agent",
    "gemini",
    "local-first",
    "chatbot",
    "bun",
    "typescript",
    "baileys",
    "personal-assistant"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts start",
    "dev": "bun --watch run src/cli.ts start",
    "relink": "bun run src/cli.ts relink",
    "config:show": "bun run src/cli.ts config:show",
    "config:init": "bun run src/cli.ts config:init",
    "persona:init": "bun run src/cli.ts persona:init",
    "persona:paths": "bun run src/cli.ts persona:paths",
    "persona:dump": "bun run src/cli.ts persona:dump",
    "groups:list": "bun run src/cli.ts groups:list",
    "groups:active": "bun run src/cli.ts groups:active",
    "direct:active": "bun run src/cli.ts direct:active",
    "direct:list": "bun run src/cli.ts direct:list",
    "direct:allow": "bun run src/cli.ts direct:allow",
    "direct:disallow": "bun run src/cli.ts direct:disallow",
    "self:add": "bun run src/cli.ts self:add",
    "self:remove": "bun run src/cli.ts self:remove",
    "contact:resolve": "bun run src/cli.ts contact:resolve",
    "logs:mode": "bun run src/cli.ts logs:mode",
    "logs:toggle": "bun run src/cli.ts logs:toggle",
    "direct:poke": "bun run src/cli.ts direct:poke",
    "memory:list": "bun run src/cli.ts memory:list",
    "memory:clear": "bun run src/cli.ts memory:clear",
    "memory:export": "bun run src/cli.ts memory:export",
    "typecheck": "tsc --noEmit",
    "ui:dev": "cd web-ui && bun run dev",
    "ui:build": "cd web-ui && bun run build",
    "ui:preview": "cd web-ui && bun run preview"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "baileys": "7.0.0-rc.9",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-terminal": "^0.12.2",
    "bun-types": "^1.3.12",
    "typescript": "^5.8.3"
  }
}
