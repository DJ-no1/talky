# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.

# Required — get a free key at https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — enables semantic memory search (https://mem0.ai)
MEM0_API_KEY=

# Optional — enables GIF reactions via Klipy (https://klipy.co)
KLIPY_APP_KEY=

# Web control UI (Bun HTTP server, not HTTPS). Override port if needed:
# WEB_UI_PORT=4173
#
# If you use `bun run ui:dev` (Vite), it proxies `/api/*` to Talky. Use http:// only — https:// will TLS-fail.
# You can set this in the repo root `.env` (loaded by `web-ui/vite.config.ts`) or in `web-ui/.env.development`:
# VITE_API_PROXY_TARGET=http://127.0.0.1:4173
#
# If `/api/*` fails with proxy or SSL errors while on VPN, force bypass for localhost, e.g. in PowerShell:
#   $env:NO_PROXY = "127.0.0.1,localhost,::1"

# Optional overrides
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# KLIPY_LOCALE=en
# KLIPY_CONTENT_FILTER=medium

# Optional — use external Voicebox server for voice notes (falls back to Gemini TTS if unavailable)
# VOICEBOX_BASE_URL=http://127.0.0.1:8000
# VOICEBOX_PROFILE_ID=replace-with-profile-id
# VOICEBOX_LANGUAGE=en
# VOICEBOX_ENGINE=qwen
# VOICEBOX_MODEL_SIZE=1.7B
